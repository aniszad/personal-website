# Create a fine-grained Hugging Face token with “Make calls to Inference Providers”
# permission, then set this value in .env.local for development and in Vercel for
# Production, Preview, and Development deployments. Never commit the real token.
HF_TOKEN=hf_your_token_here

# Optional. The :fastest suffix lets Hugging Face select an available provider.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:fastest
